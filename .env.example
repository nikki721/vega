# Copy this file to .env.local and fill in your own project's values.
# Find both of these in your Supabase project: Project Settings -> API.
#
# VITE_SUPABASE_URL is your project URL, e.g. https://abcdefgh.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY is the "anon" / "publishable" public key —
# NOT the service_role key. The anon key is safe to ship in frontend code
# because Row Level Security enforces what it can actually read or write.

VITE_SUPABASE_URL=https://qyupltbhtelnkzevvkds.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_stpxJvbWdap72s6Bj6hI6Q_ZAY1-Yt5
